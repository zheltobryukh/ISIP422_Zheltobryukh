<Window x:Class="ISIP422_Zheltobryukh.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить товар" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Margin="100,0,0,0"/>

        <TextBlock Text="Цена:" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="PriceTextBox" Grid.Row="1" Margin="100,0,0,0"/>

        <TextBlock Text="Количество:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="QuantityTextBox" Grid.Row="2" Margin="100,0,0,0"/>

        <TextBlock Text="Категория:" Grid.Row="3" VerticalAlignment="Center"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Margin="100,0,0,0">
            <ComboBoxItem Content="Еда"/>
            <ComboBoxItem Content="Электроника"/>
            <ComboBoxItem Content="Книги"/>
            <ComboBoxItem Content="Разное"/>
        </ComboBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Width="80" Margin="5" Click="AddButton_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
