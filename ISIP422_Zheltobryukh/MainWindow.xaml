<Window x:Class="ISIP422_Zheltobryukh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ISIP422_Zheltobryukh"
        Title="Учёт товаров в магазине" Height="500" Width="900">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Панель кнопок -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="Добавить" Width="100" Margin="5" Click="Add_Click"/>
            <Button Content="Удалить" Width="100" Margin="5" Click="Delete_Click"/>
            <Button Content="Заказать" Width="100" Margin="5" Click="Restock_Click"/>
            <Button Content="Продать" Width="100" Margin="5" Click="Sell_Click"/>
            <Button Content="Отменить продажу" Width="120" Margin="5" Click="Undo_Click"/>
            <Button Content="Отчёт" Width="100" Margin="5" Click="Report_Click"/>
        </StackPanel>

        <!-- Список товаров -->
        <ListBox ItemsSource="{Binding Products}" x:Name="ProductsList" FontSize="16"/>
    </DockPanel>
</Window>
